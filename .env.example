# KRISHNA AI - server-only secrets
# Copy this file to .env.local for local development.

# Optional server TTS providers. Keep these server-only. Never prefix them with NEXT_PUBLIC.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx

# Optional D-ID talking avatar provider.
# DID_API_KEY is usually the Basic auth token expected by D-ID.
# DID_SOURCE_URL must be a public HTTPS image URL for the avatar source.
DID_API_KEY=
DID_SOURCE_URL=
DID_VOICE_ID=en-US-GuyNeural

# Public app URL for deployment metadata/share flows.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Google OAuth (for Sign in with Google) ───────────────────────────────────
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → APIs & Services → Credentials → OAuth 2.0 Client ID
# 3. Application type: Web
# 4. Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
# 5. Copy the Client ID and Secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

