# Auto-detect text files and normalize line endings
* text=auto

# Force Unix LF for source files
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.env.example text eol=lf

# Binary files — never convert
*.mp3  binary
*.mp4  binary
*.jpg  binary
*.jpeg binary
*.png  binary
*.ico  binary
*.woff2 binary
